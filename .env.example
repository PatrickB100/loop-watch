# Cisco switches: read-only account, used by every device without a `credentials:` key
LOOPWATCH_SSH_USER=
LOOPWATCH_SSH_PASSWORD=
LOOPWATCH_SSH_ENABLE=

# MikroTik: used by devices with `credentials: mikrotik` (RouterOS group "read" is enough)
LOOPWATCH_MIKROTIK_USER=
LOOPWATCH_MIKROTIK_PASSWORD=

# Any other LOOPWATCH_<NAME>_USER / LOOPWATCH_<NAME>_PASSWORD pair defines the credential set <name>.

# Where things live inside the container (match the compose volume)
LOOPWATCH_INVENTORY=/data/inventory.yaml
LOOPWATCH_DB=/data/loopwatch.sqlite

# Web page and time zone for everything shown
LOOPWATCH_WEB_PORT=8080
LOOPWATCH_TZ=Europe/Amsterdam
